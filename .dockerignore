# The build context is what gets shipped to the daemon before anything runs, so
# the expensive entries here are the two directories that are both large and
# regenerated inside the image anyway.
.git
.github

# ~200 MB, reinstalled from the lockfile in the web stage.
web/node_modules
web/.svelte-kit
web/build

# Generated by the web stage and copied in from it. Excluding it also removes
# the only way a stale local frontend build could end up in a released image.
internal/ui/dist

# Its own Go module, built and run separately; nothing in the image needs it.
harness

# Local state. A developer's SQLite database holds real monitor credentials
# (data model §12) and must never be baked into a layer.
data
*.db
*.db-wal
*.db-shm
*.key

# Build output and editor droppings.
cairn
/dist
/bin
.DS_Store
.idea
*.swp

docs
*.md
!README.md
