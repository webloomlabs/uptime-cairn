# Build output
/cairn
/dist/
/bin/

# The frontend build lands in internal/ui/dist and is embedded at compile time.
# Everything there is generated, including index.html, so nothing is committed
# except .gitkeep — which exists only so //go:embed has a non-empty directory to
# find in a clean checkout. Tracking the built index.html would mean every
# developer who runs the frontend build has a dirty tree and eventually commits
# a build artefact.
/internal/ui/dist/*
!/internal/ui/dist/.gitkeep

# Frontend
/web/node_modules/
/web/.svelte-kit/
/web/build/

# Local data — a dev run writes a real SQLite database and it must never be
# committed: it holds monitor credentials (data model §12).
*.db
*.db-wal
*.db-shm
/data/

# Editors, OS
.DS_Store
.idea/
*.swp
